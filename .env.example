# HappiMynd platform integration
#
# The site reuses the platform's existing Laravel Sanctum cookie session — it
# does not hold credentials or tokens of its own. For the session cookie to be
# sent, this site must be served from the same registrable domain as the API
# (e.g. happimynd.com and www.happimynd.com), and the API must allow this
# origin with `supports_credentials` enabled.

# Origin of the platform API. Leave empty when this site is served from the
# same origin as the backend (the default, matching the contact form).
VITE_HAPPIMYND_API_BASE=

# Endpoint returning the authenticated user as JSON, 401/419 when signed out.
# Sanctum's convention is /api/user.
VITE_HAPPIMYND_USER_ENDPOINT=/api/user

# Platform login page.
VITE_HAPPIMYND_LOGIN_URL=https://happimynd.com/login

# Query parameter the login page reads to return the visitor here afterwards.
# The login page must honour this for the return leg to work automatically.
VITE_HAPPIMYND_LOGIN_REDIRECT_PARAM=redirect
